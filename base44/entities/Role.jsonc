{
  "name": "Role",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Role name"
    },
    "roleGroup": {
      "type": "string",
      "description": "Group: Floor, Cage, Kitchen, Bar, Management, Other"
    },
    "color": {
      "type": "string",
      "description": "Hex color code for schedule visibility"
    },
    "displayOrder": {
      "type": "number",
      "default": 0
    },
    "assignedLocationIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Locations where this role is available. Empty = available at all locations."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "name"
  ]
}