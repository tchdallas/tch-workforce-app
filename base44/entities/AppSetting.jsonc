{
  "name": "AppSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "company",
        "location",
        "user"
      ],
      "default": "company"
    },
    "locationId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "value"
  ]
}